# ----------------------------------------------------------------
# Site URL — Used for Stripe success/cancel redirects, OG images,
# JSON-LD, and email links
# ----------------------------------------------------------------
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_SITE_URL=https://masteringfse.com

# ----------------------------------------------------------------
# Admin emails — comma-separated list of admin email addresses
# These users will have admin role access
# ----------------------------------------------------------------
ADMIN_EMAILS=your-admin-email@example.com

# ----------------------------------------------------------------
# IP Hash Secret — used to HMAC-hash IP addresses for storage
# Generate a strong random string (32+ chars)
# ----------------------------------------------------------------
IP_HASH_SECRET=generate-a-strong-random-secret-here

# ----------------------------------------------------------------
# Seed endpoint secret — protects /api/admin/seed-questions
# Generate a strong random string. Leave blank to disable the endpoint.
# ----------------------------------------------------------------
SEED_SECRET=generate-a-strong-random-secret-here

# ----------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------
# Set to 'true' to show the beta warning banner across the top of the site
NEXT_PUBLIC_BETA_MODE=false

# Cron secret — required bearer token for /api/cron/* endpoints
CRON_SECRET=generate-a-strong-random-secret-here

# SendGrid API key — for transactional emails
SENDGRID_API_KEY=SG.xxx
