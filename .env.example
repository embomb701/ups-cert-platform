# ================================================================
# UPS CERT PLATFORM — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to git.
# ================================================================

# ----------------------------------------------------------------
# Firebase — Client-side (safe to expose in browser)
# ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------
# Firebase Admin SDK — Server-side only (NEVER expose to browser)
# Get from Firebase Console > Project Settings > Service Accounts
# ----------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=
# Paste the private key including -----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----
# In .env.local use: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ----------------------------------------------------------------
# Stripe — Server-side only
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Publishable Key — safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ----------------------------------------------------------------
# Stripe Price IDs — create these in your Stripe Dashboard
# All prices are in USD. Omitting a price means checkout is disabled
# for that product (falls back to empty string → Stripe error).
# ----------------------------------------------------------------

# UPS FSE Training Course ($1,499)
STRIPE_PRICE_ID_TRAINING_COURSE=price_...
# UPS Practice Test (free via training, sold separately)
STRIPE_PRICE_ID_PRACTICE_TEST=price_...
# Jr. FSE Test-Out Exam ($299)
STRIPE_PRICE_ID_JR_FSE_HUMAN=price_...
# Jr. FSE + Test-Out Bundle ($1,699)
STRIPE_PRICE_ID_PKG_JR_HUMAN=price_...
# Human Proctored FSE Exam ($649)
STRIPE_PRICE_ID_FSE=price_...
# Human Proctored FSE Bundle
STRIPE_PRICE_ID_PKG_FSE=price_...

# Kitchen training + test-out
STRIPE_PRICE_ID_TRAINING_KITCHEN=price_...
